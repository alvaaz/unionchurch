---
import Layout from "../layouts/Layout.astro";
import LatestServices from "../components/LatestServices.astro";
import CircleFinal from "../components/CircleFinal.astro";
import LatestsShepperdDecks from "../components/LatestsShepperdDecks.astro";
import Header from "../components/Header.astro";
import Facebook from "../components/icons/Facebook.astro";
import Youtube from "../components/icons/Youtube.astro";
import Instagram from "../components/icons/Instagram.astro";
import mujeres from "../assets/ministries/1.png";
import unionKids from "../assets/ministries/2.png";
import unionX from "../assets/ministries/3.png";
import hombres from "../assets/ministries/4.png";
import dorados from "../assets/ministries/5.png";
import horaciopatty from "../assets/horaciopatty.png";
import sign from "../assets/sign.png";
import cover from "../assets/cover.jpg";
import { Image } from "astro:assets";
---

<Layout>
  <div class="h-screen">
    <img class="absolute object-cover" alt="Cover" src={cover.src} />
    <Header />
    <div class="h-full flex justify-center items-center relative">
      <div>
        <p class="text-center text-white font-serif text-5xl mb-20 md:text-6xl lg:text-8xl">
          Bienvenido a casa
        </p>
        <div class="flex justify-center">
          <a href="https://www.facebook.com/unionchurch.cl" target="_blank" rel="noreferrer">
            <Facebook class="mr-8" />
          </a>
          <a href="https://www.instagram.com/unionchurch.cl/" target="_blank" rel="noreferrer">
            <Instagram class="mr-8" />
          </a>
          <a href="https://www.youtube.com/c/UnionChurchcl" target="_blank" rel="noreferrer">
            <Youtube />
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="container mx-auto mb-20 md:mb-40 px-8 sm:px-8">
    <div
      class="mt-20 flex justify-center items-center flex-col md:flex-row text-center md:text-left"
    >
      <div class="mb-12 md:mb-0">
        <Image src={horaciopatty} alt="Horacio y Patty" width={382} height={300} />
      </div>
      <div class="md:ml-16 md:w-4/12">
        <p class="font-serif text-2xl md:text-3xl lg:text-4xl text-gray-800 mb-8">
          Uniendo personas con propósito
        </p>
        <p class="font-xl text-gray-600 mb-8">
          Bienvenidos a Union Church. Somos una comunidad de La Viña que busca vivir los valores
          bíblicos, experimentando naturalmente lo sobrenatural. Te invitamos a vivir un encuentro
          con Jesús, a cultivar una relación de intimidad con Dios, tener relaciones significativas
          con otras personas, crecer y vivir la Palabra y extender el Reino de Dios con tu vida.
        </p>
        <div>
          <Image src={sign} alt="Horacio & Patty's Sign" width={217} height={57} />
        </div>
        <p>
          <span class="block font-bold">Pastores principales</span>
        </p>
      </div>
    </div>
  </div>

  <p class="text-lg sm:text-xl md:text-2xl text-gray-800 mb-2 text-center">
    Intégrate a nuestros grupos de crecimiento
  </p>
  <div class="flex justify-center flex-wrap space-x-8">
    <Image
      alt=""
      width={160}
      height={160}
      src={mujeres}
      class="filter grayscale hover:grayscale-0"
    />
    <Image
      alt=""
      width={160}
      height={160}
      src={hombres}
      class="filter grayscale hover:grayscale-0"
    />
    <Image
      alt=""
      width={160}
      height={160}
      src={dorados}
      class="filter grayscale hover:grayscale-0"
    />
    <Image
      alt=""
      width={160}
      height={160}
      src={unionX}
      class="filter grayscale hover:grayscale-0"
    />
    <Image
      alt=""
      width={160}
      height={160}
      src={unionKids}
      class="filter grayscale hover:grayscale-0"
    />
  </div>
  <div class="px-8 sm:px-0 bg-pink-light" style={{ zIndex: "-1" }}>
    <div class="relative">
      <div class="container mx-auto mt-40 flex items-center">
        <div class="py-12 md:py-0">
          <p class="font-serif text-2xl md:text-3xl lg:text-4xl text-gray-800 mb-4">
            Hacemos iglesia presencial y en línea
          </p>
          <p class="text-lg sm:text-xl md:text-2xl text-gray-700 mb-12">
            ¡Juntos hacemos la iglesia!{" "}
          </p>
          <a
            href="https://www.youtube.com/c/UnionChurchcl"
            class="tracking-wider uppercase text-sm inline px-8 py-3 border border-primary font-bold bg-primary hover:bg-primary-dark text-white transition duration-150 ease-in-out"
          >
            Ir al canal de Youtube
          </a>
        </div>
        <CircleFinal class="opacity-0 hidden md:block" />
      </div>
      <CircleFinal class="absolute top-0 right-0 hidden md:block" />
    </div>
  </div>

  <div class="text-center relative pb-20 md:pb-40 pt-10">
    <div class="container mx-auto flex items-center justify-between py-16">
      <p class="font-serif text-2xl md:text-3xl lg:text-4xl text-gray-800">Últimos servicios</p>
      <a
        target="_blank"
        class="text-yellow-700 font-semibold border-b-4 flex items-center"
        href="https://youtube.com/playlist?list=PLV_Ax0JpimXPtD-QDqcygoAwERU0rvU82"
        rel="noreferrer"
      >
        Ver todos
      </a>
    </div>
    <LatestServices />
    <div class="flex items-center justify-between py-16">
      <p class="font-serif text-2xl md:text-3xl lg:text-4xl text-gray-800">Escritorio del pastor</p>
      <a
        target="_blank"
        class="text-yellow-700 font-semibold border-b-4 flex items-center"
        href="https://youtube.com/playlist?list=PLV_Ax0JpimXPgTVH7fvCVC-2X0XQ6vorg"
        rel="noreferrer"
      >
        Ver todos
      </a>
    </div>
    <LatestsShepperdDecks />
  </div>
</Layout>
