---
import logo from "../assets/logo-white.svg";
---

<div
  class="bg-gradient-to-b from-gray-900 to-transparent w-full py-10 absolute top-0"
  style={{ zIndex: 1 }}
>
  <nav class="container mx-auto px-8 md:px-0 flex items-center">
    <a href="/">
      <img alt="Logo" src={logo.src} height="57" width="145" />
    </a>
    <a
      href="/nosotros"
      class="ml-8 mr-8 text-white text-lg border-transparent border-b-4 hover:border-white"
    >
      Nosotros
    </a>
    <a href="/dar" class="text-white text-lg border-transparent border-b-4 hover:border-white">
      Dar
    </a>
  </nav>
</div>
