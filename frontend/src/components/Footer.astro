---
import { Image } from "astro:assets";
import FooterIllustration from "../components/FooterIllustration.astro";
import Facebook from "../components/icons/Facebook.astro";
import Youtube from "../components/icons/Youtube.astro";
import Instagram from "../components/icons/Instagram.astro";
import logo from "../assets/logo-white.svg";
---

<div class="bg-[#1C2C2D]">
  <div
    class="container mx-auto flex justify-between flex-col md:flex-row px-8 sm:px-0 py-32 text-white"
  >
    <div class="md:pl-12">
      <div class="mb-8">
        <Image src={logo} width={146} height={73} alt="logo" loading="lazy" class="mb-6" />
        <div class="flex
          justify-center
          mb-8">
          <a href="https://www.facebook.com/unionchurch.cl" target="_blank" rel="noreferrer">
            <Facebook class="mr-8" />
          </a>
          <a href="https://www.instagram.com/unionchurch.cl/" target="_blank" rel="noreferrer">
            <Instagram class="mr-8" />
          </a>
          <a href="https://www.youtube.com/c/UnionChurchcl" target="_blank" rel="noreferrer">
            <Youtube />
          </a>
        </div>
      </div>
      <a
        href="/dar"
        class="tracking-wider uppercase text-sm px-8 py-3 border border-white font-bold bg-transparent text-white transition duration-150 ease-in-out"
      >
        Dar
      </a>
    </div>

    <div class="mt-8 md:mt-0 mb-8 md:mb-0 md:px-12">
      <p class="font-serif text-2xl my-4 font-medium md:mt-0">Reuniones</p>
      <p class="mb-4">
        <span class="font-bold text-lg block">Reunión general</span>{" "}
        Domingos a las 11:00 hrs
      </p>
      <p>
        <span class="font-bold text-lg block"> Reuniones de oración </span>{" "}
        <p>Domingos a las 10:00 hrs — Presencial</p>
        <p>Miércoles a las 20:00 hrs — Zoom</p>
      </p>
    </div>
    <div class="mb-8 md:mb-0">
      <p class="font-serif text-2xl my-4 font-medium md:mt-0">Contacto</p>
      <p class="mb-4">
        <span class="font-bold text-lg block">Teléfono</span> 32 2125033
      </p>
      <p>
        <span class="font-bold text-lg block"> Celular / WhatsApp </span>{" "}

        <a href="https://wa.me/56965696958"> +56 9 6569 6958</a>
      </p>
    </div>
    <div class="md:px-12">
      <p class="font-serif text-2xl my-4 font-medium md:mt-0">Ubicación y horario</p>
      <a
        href="https://maps.app.goo.gl/X3dMb6e83VZgmR2b7?g_st=com.google.maps.preview.copy"
        class="mb-4 inline-block">Von Schroeders #356, Viña del mar, Chile</a
      >
      <p>
        <span class="font-bold text-lg block">Lunes a Viernes</span>{" "}
        9:00 a 14:00 hrs y 15:00 a 18:00 hrs
      </p>
    </div>
  </div>
  <div style={{ height: "32px", overflowX: "hidden" }}>
    <FooterIllustration />
  </div>
</div>
